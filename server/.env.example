PORT=3001
NODE_ENV=development
MONGODB_URI=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# First manager — used by: npx ts-node server/src/scripts/seedAdmin.ts
ADMIN_AUTH0_SUB=
ADMIN_EMAIL=
ADMIN_NAME=

CLOUDINARY_URL=
CLOUDINARY_PENDING_FOLDER=barryos/pending
CLOUDINARY_PUBLIC_FOLDER=barryos/gallery
MAX_UPLOAD_BYTES=8000000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_SUBMISSIONS=10
RATE_LIMIT_MAX_TICKETS=20

# PayPal Checkout for Christmas advance tickets. The secret stays on the server.
# sandbox talks to PayPal's test API. live charges real cards.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# Production only — add Vercel preview URLs here if needed
CLIENT_URL=https://barryostavern.com
